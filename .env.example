# ======================
# AI Marketing Platform
# ======================

# LLM Provider (openai | anthropic | mock)
# Set to "mock" or leave API keys blank for offline mode
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_SMART=gpt-4o

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/marketing

# Qdrant (vector database)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=marketing_docs

# Auth
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# Default admin (seeded on first startup if no admin exists)
ADMIN_EMAIL=admin@mktplatform.com
ADMIN_PASSWORD=Admin@123456

# OAuth (leave blank to hide social login buttons)
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# PostHog analytics (leave blank to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SePay payment gateway
# 1) Create a webhook in the SePay dashboard pointing to:
#      https://<backend-domain>/payments/sepay-webhook
# Auth — pick ONE (HMAC preferred):
#   a) HMAC-SHA256 (recommended): paste the webhook Secret Key here.
SEPAY_WEBHOOK_SECRET=
#   b) Or API Key auth (Authorization: Apikey <key>) — used only if no secret is set:
SEPAY_API_KEY=
# 2) The bank account that receives transfers (used to render the VietQR + checkout info).
#    SEPAY_BANK_CODE uses SePay/VietQR short names: Vietcombank, MBBank, BIDV, ACB, Techcombank, VPBank, ...
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_HOLDER=
SEPAY_BANK_NAME=

# Application environment (development | production)
ENVIRONMENT=development
# CORS_ORIGINS must list EVERY frontend origin that calls this backend, comma-separated.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (Railway) example — set this on the BACKEND service's env vars:
#   CORS_ORIGINS=https://vitbaproduction.up.railway.app,https://vitba.ai
# NOTE: the frontend's NEXT_PUBLIC_API_URL is baked at BUILD time (it is a Docker
# build ARG), so it must be set as a build-time variable on the FRONTEND service,
# pointing at the backend, e.g. NEXT_PUBLIC_API_URL=https://vitbaai.up.railway.app

# Production database (override for docker-compose.prod.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=strong-password-here
# POSTGRES_DB=marketing
